# Copy to .env and fill in. .env is gitignored.

GARMIN_EMAIL=
GARMIN_PASSWORD=

# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: override the model
# GEMINI_MODEL=gemini-2.5-flash

# Telegram (optional for first tests: without it the report is only printed/stored).
# 1) create a bot with @BotFather -> token
# 2) send any message to your bot, then run `coach telegram-setup` to get the chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: where the SQLite DB, raw payloads, Garmin tokens and logs live
# COACH_DATA_DIR=
